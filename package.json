{
  "name": "testmate",
  "version": "1.0.0",
  "description": "TestMate - Automated test documentation generator for Azure DevOps",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm start",
    "dev:all": "concurrently \"npm run dev\" \"npm run client\"",
    "start:all": "concurrently \"npm start\" \"npm run client\""
  },
  "keywords": [
    "testing",
    "documentation",
    "azure-devops",
    "openai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "openai": "^4.20.1",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.2"
  }
}